{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ClipSource": {
      "additionalProperties": false,
      "description": "ClipSource is a named animation of a texture's frames.",
      "properties": {
        "fps": {
          "type": "number"
        },
        "frames": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "loop": {
          "description": "default true",
          "type": "boolean"
        },
        "next": {
          "description": "the clip that follows a clip that does not loop",
          "type": "string"
        }
      },
      "required": [
        "fps",
        "frames"
      ],
      "type": "object"
    },
    "EdgeSource": {
      "additionalProperties": false,
      "description": "EdgeSource shapes the border a terrain draws over the cells of lower terrains around it.",
      "properties": {
        "priority": {
          "type": "integer"
        },
        "roughness": {
          "description": "0 to 1, default 0.5",
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "width": {
          "description": "pixels, default a quarter of a frame's smaller side",
          "type": "number"
        }
      },
      "required": [
        "priority"
      ],
      "type": "object"
    },
    "FrameSource": {
      "additionalProperties": false,
      "description": "FrameSource is one frame of a texture drawn frame by frame.",
      "properties": {
        "layers": {
          "items": {
            "$ref": "#/definitions/LayerSource"
          },
          "type": "array"
        }
      },
      "required": [
        "layers"
      ],
      "type": "object"
    },
    "LayerSource": {
      "additionalProperties": false,
      "description": "LayerSource is one step of a texture's layer program. Which fields are allowed depends on Type.",
      "properties": {
        "angle_deg": {
          "type": "number"
        },
        "blend": {
          "description": "normal (default), multiply, screen, add",
          "enum": [
            "normal",
            "multiply",
            "screen",
            "add"
          ],
          "type": "string"
        },
        "cells": {
          "type": "integer"
        },
        "center": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "color": {
          "type": "string"
        },
        "colors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "corner": {
          "type": "number"
        },
        "fit": {
          "description": "contain (default), cover, stretch",
          "enum": [
            "contain",
            "cover",
            "stretch"
          ],
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "octaves": {
          "type": "integer"
        },
        "opacity": {
          "description": "default 1",
          "type": "number"
        },
        "outline": {
          "type": "number"
        },
        "path": {
          "type": "string"
        },
        "radius": {
          "type": "number"
        },
        "rect": {
          "description": "image: [x, y, width, height] of the PNG to use (default all)",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "scale": {
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "size": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "description": "solid, noise, stripes, rect, circle, gradient, checker, image",
          "enum": [
            "solid",
            "noise",
            "stripes",
            "rect",
            "circle",
            "gradient",
            "checker",
            "image"
          ],
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "xy": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  },
  "description": "TextureSource is assets/textures/<name>.vtex.",
  "properties": {
    "autotile": {
      "description": "Autotile: every frame is 6 × 3 tiles, an island and a lake, picked by a map's cells.",
      "type": "boolean"
    },
    "clips": {
      "additionalProperties": {
        "$ref": "#/definitions/ClipSource"
      },
      "description": "named sequences of frames",
      "type": "object"
    },
    "edge": {
      "$ref": "#/definitions/EdgeSource",
      "description": "how the texture spills over lower terrains in a map"
    },
    "frames": {
      "description": "Frames draws the frames one by one, each size wide, over Layers.",
      "items": {
        "$ref": "#/definitions/FrameSource"
      },
      "type": "array"
    },
    "grid": {
      "description": "Grid cuts the image into frames: [columns, rows].",
      "items": {
        "type": "integer"
      },
      "type": "array"
    },
    "layers": {
      "items": {
        "$ref": "#/definitions/LayerSource"
      },
      "type": "array"
    },
    "mipmaps": {
      "description": "default true, false for a sheet of frames",
      "type": "boolean"
    },
    "play": {
      "description": "the clip shown when nothing picks a frame",
      "type": "string"
    },
    "size": {
      "items": {
        "type": "integer"
      },
      "type": "array"
    },
    "tiling": {
      "type": "boolean"
    },
    "veduta": {
      "const": "texture/1"
    }
  },
  "required": [
    "size",
    "veduta"
  ],
  "title": "texture",
  "type": "object"
}
