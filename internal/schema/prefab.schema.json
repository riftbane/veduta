{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "EntitySource": {
      "additionalProperties": false,
      "description": "EntitySource is one entity of a scene.",
      "properties": {
        "hitbox": {
          "description": "Hitbox is [[minx, miny, minz], [maxx, maxy, maxz]] in the entity's local space.",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "kind": {
          "type": "string"
        },
        "layer": {
          "description": "draw order, -1000..1000, default 0",
          "type": "integer"
        },
        "material": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "position": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "rotation_deg": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "scale": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "visible": {
          "description": "default true",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "RulesSource": {
      "additionalProperties": false,
      "description": "RulesSource are the placement rules of a prefab.",
      "properties": {
        "biomes": {
          "description": "biomes the prefab may stand in (default: any)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "min_distance": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "tag → meters of free ground",
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "description": "PrefabSource is assets/prefabs/<name>.prefab.json.",
  "properties": {
    "entities": {
      "items": {
        "$ref": "#/definitions/EntitySource"
      },
      "type": "array"
    },
    "footprint": {
      "description": "[width, depth] in meters",
      "items": {
        "type": "number"
      },
      "type": "array"
    },
    "rules": {
      "$ref": "#/definitions/RulesSource"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "veduta": {
      "const": "prefab/1"
    }
  },
  "required": [
    "entities",
    "footprint",
    "veduta"
  ],
  "title": "prefab",
  "type": "object"
}
