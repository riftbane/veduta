{
  "name": "veduta",
  "displayName": "Veduta",
  "description": "Make Veduta console games: new game, play and debug (F5), test, build with errors in Problems, deploy to the console's card.",
  "version": "0.3.0",
  "publisher": "riftbane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/riftbane/veduta"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "veduta",
    "lua",
    "game",
    "console"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:veduta.json",
    "onDebugResolve:veduta",
    "onDebugDynamicConfigurations:veduta"
  ],
  "contributes": {
    "commands": [
      {
        "command": "veduta.newGame",
        "title": "New Game",
        "category": "Veduta"
      },
      {
        "command": "veduta.play",
        "title": "Play in the Simulator",
        "category": "Veduta",
        "icon": "$(play)"
      },
      {
        "command": "veduta.test",
        "title": "Test",
        "category": "Veduta"
      },
      {
        "command": "veduta.build",
        "title": "Build",
        "category": "Veduta"
      },
      {
        "command": "veduta.deploy",
        "title": "Deploy to the Console's Card",
        "category": "Veduta"
      }
    ],
    "configuration": {
      "title": "Veduta",
      "properties": {
        "veduta.path": {
          "type": "string",
          "default": "",
          "description": "The veduta program. Empty: veduta on PATH, or where install.ps1 puts it."
        },
        "veduta.buildOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Build when a script or an asset is saved, and show its errors in Problems."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "veduta",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "sim",
              "run",
              "test",
              "build",
              "deploy",
              "fuzz",
              "bench"
            ],
            "description": "The veduta command to run in the project."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "veduta",
        "owner": "veduta",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(?:vet: )?([^\\s:][^:]*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "breakpoints": [
      {
        "language": "lua"
      }
    ],
    "debuggers": [
      {
        "type": "veduta",
        "label": "Veduta",
        "languages": [
          "lua"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "project": {
                "type": "string",
                "description": "The game's folder.",
                "default": "${workspaceFolder}"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "play",
                  "scenario"
                ],
                "enumDescriptions": [
                  "Play the game: the simulator on Windows, the framebuffer on Linux.",
                  "Run a scenario headless."
                ],
                "default": "play"
              },
              "scenario": {
                "type": "string",
                "description": "With mode scenario: its name (tests/scenarios/<name>.scenario.json) or file."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the first statement.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "veduta",
            "request": "launch",
            "name": "Play",
            "project": "${workspaceFolder}",
            "mode": "play"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Veduta: Play",
            "description": "Play the game with the debugger",
            "body": {
              "type": "veduta",
              "request": "launch",
              "name": "Play",
              "project": "^\"\\${workspaceFolder}\"",
              "mode": "play"
            }
          },
          {
            "label": "Veduta: Scenario",
            "description": "Run a scenario with the debugger",
            "body": {
              "type": "veduta",
              "request": "launch",
              "name": "Scenario",
              "project": "^\"\\${workspaceFolder}\"",
              "mode": "scenario",
              "scenario": "start"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0"
  }
}
