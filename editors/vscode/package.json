{
  "name": "veduta",
  "displayName": "Veduta",
  "description": "Make Veduta console games: the project as a tree with new scenes, prefabs, models and scripts on right-click, play and debug (F5), test, build with errors in Problems, preview a texture while you write it, deploy to the console's card.",
  "version": "0.8.0",
  "publisher": "riftbane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/riftbane/veduta"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "veduta",
    "lua",
    "game",
    "console"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:veduta.json",
    "onDebugResolve:veduta",
    "onDebugDynamicConfigurations:veduta"
  ],
  "contributes": {
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".vmodel",
          ".vtex",
          ".vmat",
          ".vscene",
          ".vscenario",
          ".vprefab",
          ".vworld"
        ]
      }
    ],
    "commands": [
      {
        "command": "veduta.newGame",
        "title": "New Game",
        "category": "Veduta"
      },
      {
        "command": "veduta.play",
        "title": "Play in the Simulator",
        "category": "Veduta",
        "icon": "$(play)"
      },
      {
        "command": "veduta.test",
        "title": "Test",
        "category": "Veduta"
      },
      {
        "command": "veduta.build",
        "title": "Build",
        "category": "Veduta"
      },
      {
        "command": "veduta.deploy",
        "title": "Deploy to the Console's Card",
        "category": "Veduta"
      },
      {
        "command": "veduta.previewTexture",
        "title": "Preview the Texture",
        "category": "Veduta",
        "icon": "$(eye)"
      },
      {
        "command": "veduta.view.new",
        "title": "New…",
        "category": "Veduta",
        "icon": "$(add)"
      },
      {
        "command": "veduta.view.refresh",
        "title": "Refresh the Project View",
        "category": "Veduta",
        "icon": "$(refresh)"
      },
      {
        "command": "veduta.view.newScene",
        "title": "New Scene…",
        "category": "Veduta",
        "icon": "$(add)"
      },
      {
        "command": "veduta.view.newWorld",
        "title": "New World…",
        "category": "Veduta",
        "icon": "$(add)"
      },
      {
        "command": "veduta.view.newPrefab",
        "title": "New Prefab…",
        "category": "Veduta",
        "icon": "$(add)"
      },
      {
        "command": "veduta.view.newModel",
        "title": "New Model…",
        "category": "Veduta",
        "icon": "$(add)"
      },
      {
        "command": "veduta.view.newMaterial",
        "title": "New Material…",
        "category": "Veduta",
        "icon": "$(add)"
      },
      {
        "command": "veduta.view.newTexture",
        "title": "New Texture…",
        "category": "Veduta",
        "icon": "$(add)"
      },
      {
        "command": "veduta.view.newScenario",
        "title": "New Scenario…",
        "category": "Veduta",
        "icon": "$(add)"
      },
      {
        "command": "veduta.view.newScript",
        "title": "New Script…",
        "category": "Veduta",
        "icon": "$(add)"
      },
      {
        "command": "veduta.view.newFolder",
        "title": "New Folder…",
        "category": "Veduta",
        "icon": "$(new-folder)"
      },
      {
        "command": "veduta.view.newScenarioHere",
        "title": "New Scenario Starting Here…",
        "category": "Veduta"
      },
      {
        "command": "veduta.view.play",
        "title": "Play from Here",
        "category": "Veduta",
        "icon": "$(play)"
      },
      {
        "command": "veduta.view.runScenario",
        "title": "Run Scenario",
        "category": "Veduta",
        "icon": "$(run)"
      },
      {
        "command": "veduta.view.debugScenario",
        "title": "Debug Scenario",
        "category": "Veduta",
        "icon": "$(debug-alt)"
      },
      {
        "command": "veduta.view.rename",
        "title": "Rename…",
        "category": "Veduta"
      },
      {
        "command": "veduta.view.delete",
        "title": "Delete",
        "category": "Veduta"
      },
      {
        "command": "veduta.view.reveal",
        "title": "Reveal in File Explorer",
        "category": "Veduta"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "veduta.previewTexture",
          "when": "resourceFilename =~ /\\.vtex$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "veduta.previewTexture",
          "when": "resourceFilename =~ /\\.vtex$/"
        },
        {
          "command": "veduta.view.new",
          "when": "veduta.project"
        },
        {
          "command": "veduta.view.newFolder",
          "when": "false"
        },
        {
          "command": "veduta.view.newScenarioHere",
          "when": "false"
        },
        {
          "command": "veduta.view.play",
          "when": "false"
        },
        {
          "command": "veduta.view.runScenario",
          "when": "false"
        },
        {
          "command": "veduta.view.debugScenario",
          "when": "false"
        },
        {
          "command": "veduta.view.rename",
          "when": "false"
        },
        {
          "command": "veduta.view.delete",
          "when": "false"
        },
        {
          "command": "veduta.view.reveal",
          "when": "false"
        },
        {
          "command": "veduta.view.newScene",
          "when": "false"
        },
        {
          "command": "veduta.view.newWorld",
          "when": "false"
        },
        {
          "command": "veduta.view.newPrefab",
          "when": "false"
        },
        {
          "command": "veduta.view.newModel",
          "when": "false"
        },
        {
          "command": "veduta.view.newMaterial",
          "when": "false"
        },
        {
          "command": "veduta.view.newTexture",
          "when": "false"
        },
        {
          "command": "veduta.view.newScenario",
          "when": "false"
        },
        {
          "command": "veduta.view.newScript",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "veduta.view.new",
          "when": "view == veduta.project && veduta.project",
          "group": "navigation@1"
        },
        {
          "command": "veduta.play",
          "when": "view == veduta.project && veduta.project",
          "group": "navigation@2"
        },
        {
          "command": "veduta.view.refresh",
          "when": "view == veduta.project",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "veduta.view.newScene",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.scene$/",
          "group": "inline"
        },
        {
          "command": "veduta.view.newScene",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.scene$/",
          "group": "1_new@1"
        },
        {
          "command": "veduta.view.newWorld",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.world$/",
          "group": "inline"
        },
        {
          "command": "veduta.view.newWorld",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.world$/",
          "group": "1_new@1"
        },
        {
          "command": "veduta.view.newPrefab",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.prefab$/",
          "group": "inline"
        },
        {
          "command": "veduta.view.newPrefab",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.prefab$/",
          "group": "1_new@1"
        },
        {
          "command": "veduta.view.newModel",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.model$/",
          "group": "inline"
        },
        {
          "command": "veduta.view.newModel",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.model$/",
          "group": "1_new@1"
        },
        {
          "command": "veduta.view.newMaterial",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.material$/",
          "group": "inline"
        },
        {
          "command": "veduta.view.newMaterial",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.material$/",
          "group": "1_new@1"
        },
        {
          "command": "veduta.view.newTexture",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.texture$/",
          "group": "inline"
        },
        {
          "command": "veduta.view.newTexture",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.texture$/",
          "group": "1_new@1"
        },
        {
          "command": "veduta.view.newScenario",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.scenario$/",
          "group": "inline"
        },
        {
          "command": "veduta.view.newScenario",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.scenario$/",
          "group": "1_new@1"
        },
        {
          "command": "veduta.view.newScript",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.script$/",
          "group": "inline"
        },
        {
          "command": "veduta.view.newScript",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.script$/",
          "group": "1_new@1"
        },
        {
          "command": "veduta.view.newFolder",
          "when": "view == veduta.project && viewItem =~ /^(section|folder)\\.(script|scene|world|prefab|model|material|texture)$/",
          "group": "1_new@2"
        },
        {
          "command": "veduta.view.play",
          "when": "view == veduta.project && viewItem =~ /^file\\.(scene|world)$/",
          "group": "inline"
        },
        {
          "command": "veduta.view.play",
          "when": "view == veduta.project && viewItem =~ /^file\\.(scene|world)$/",
          "group": "0_run@1"
        },
        {
          "command": "veduta.view.newScenarioHere",
          "when": "view == veduta.project && viewItem =~ /^file\\.(scene|world)$/",
          "group": "1_new@1"
        },
        {
          "command": "veduta.view.runScenario",
          "when": "view == veduta.project && viewItem == file.scenario",
          "group": "inline"
        },
        {
          "command": "veduta.view.runScenario",
          "when": "view == veduta.project && viewItem == file.scenario",
          "group": "0_run@1"
        },
        {
          "command": "veduta.view.debugScenario",
          "when": "view == veduta.project && viewItem == file.scenario",
          "group": "0_run@2"
        },
        {
          "command": "veduta.previewTexture",
          "when": "view == veduta.project && viewItem == file.texture",
          "group": "inline"
        },
        {
          "command": "veduta.previewTexture",
          "when": "view == veduta.project && viewItem == file.texture",
          "group": "0_run@1"
        },
        {
          "command": "veduta.view.rename",
          "when": "view == veduta.project && viewItem =~ /^(file|folder)\\.(script|scene|world|prefab|model|material|texture|image|scenario)$/",
          "group": "7_modify@1"
        },
        {
          "command": "veduta.view.delete",
          "when": "view == veduta.project && viewItem =~ /^(file|folder)\\.(script|scene|world|prefab|model|material|texture|image|scenario)$/",
          "group": "7_modify@2"
        },
        {
          "command": "veduta.view.reveal",
          "when": "view == veduta.project && viewItem =~ /^(file|folder)\\./",
          "group": "9_reveal@1"
        }
      ]
    },
    "configuration": {
      "title": "Veduta",
      "properties": {
        "veduta.path": {
          "type": "string",
          "default": "",
          "description": "The veduta program. Empty: veduta on PATH, or where install.ps1 puts it."
        },
        "veduta.buildOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Build when a script or an asset is saved, and show its errors in Problems."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "veduta",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "sim",
              "run",
              "test",
              "build",
              "deploy",
              "fuzz",
              "bench",
              "simulate"
            ],
            "description": "The veduta command to run in the project."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Its arguments, such as --scene level1."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "veduta",
        "owner": "veduta",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(?:vet: )?([^\\s:][^:]*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "breakpoints": [
      {
        "language": "lua"
      }
    ],
    "debuggers": [
      {
        "type": "veduta",
        "label": "Veduta",
        "languages": [
          "lua"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "project": {
                "type": "string",
                "description": "The game's folder.",
                "default": "${workspaceFolder}"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "play",
                  "scenario"
                ],
                "enumDescriptions": [
                  "Play the game: the simulator on Windows, the framebuffer on Linux.",
                  "Run a scenario headless."
                ],
                "default": "play"
              },
              "scenario": {
                "type": "string",
                "description": "With mode scenario: its name (tests/scenarios/<name>.vscenario) or file."
              },
              "scene": {
                "type": "string",
                "description": "With mode play: start in this scene instead of the project's default. Saving a file reloads the game in place, in the scene it is in."
              },
              "world": {
                "type": "string",
                "description": "With mode play: start in this world instead of a scene."
              },
              "at": {
                "type": "string",
                "description": "With world: the start cell, \"x,z\"."
              },
              "seed": {
                "type": "integer",
                "description": "With mode play: the seed of math.random (default: the project's)."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the first statement.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "veduta",
            "request": "launch",
            "name": "Play",
            "project": "${workspaceFolder}",
            "mode": "play"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Veduta: Play",
            "description": "Play the game with the debugger",
            "body": {
              "type": "veduta",
              "request": "launch",
              "name": "Play",
              "project": "^\"\\${workspaceFolder}\"",
              "mode": "play"
            }
          },
          {
            "label": "Veduta: Play a scene",
            "description": "Play the game from one scene, to edit that scene or its hud while it shows",
            "body": {
              "type": "veduta",
              "request": "launch",
              "name": "Play ${1:level}",
              "project": "^\"\\${workspaceFolder}\"",
              "mode": "play",
              "scene": "${1:level}"
            }
          },
          {
            "label": "Veduta: Scenario",
            "description": "Run a scenario with the debugger",
            "body": {
              "type": "veduta",
              "request": "launch",
              "name": "Scenario",
              "project": "^\"\\${workspaceFolder}\"",
              "mode": "scenario",
              "scenario": "start"
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "veduta",
          "title": "Veduta",
          "icon": "media/veduta.svg"
        }
      ]
    },
    "views": {
      "veduta": [
        {
          "id": "veduta.project",
          "name": "Project",
          "icon": "media/veduta.svg",
          "contextualTitle": "Veduta"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "veduta.project",
        "contents": "This window has no Veduta game: open the folder of one (the folder with veduta.json), or make a new one.\n[New Game](command:veduta.newGame)",
        "when": "!veduta.project"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0"
  }
}
