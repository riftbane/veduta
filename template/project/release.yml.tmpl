name: release

on:
  push:
    tags: ["v*"]

permissions:
  contents: write

env:
  CGO_ENABLED: "0"
  GOAMD64: v1

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      # The newest stable Go, the toolchain the engine's own CI and arm64 checks run on:
      # the console's binary is built by the compiler those checks have seen.
      - uses: actions/setup-go@v6
        with:
          go-version: stable

      - name: build archives
        run: |
          set -eu
          tag="${GITHUB_REF_NAME}"
          name="[[.Name]]"
          mkdir -p build dist
          # card.json is what the console lists. The release sets its "version" to the tag
          # and, when veduta.json names an icon, ships that file as icon.png beside the card
          # and names it there. jq edits the JSON, not its lines, so any layout of the card
          # works; a card that is not one card/1 object stops the job before anything is
          # built.
          icon="$(jq -r '.icon // ""' veduta.json)"
          if [ -n "$icon" ] && [ ! -f "$icon" ]; then
            echo "veduta.json names the icon $icon, which does not exist" >&2
            exit 1
          fi
          if ! jq -s --arg version "$tag" --arg icon "${icon:+icon.png}" '
            if length == 1 and (.[0] | type) == "object" and .[0].veduta == "card/1" then
              .[0] | .version = $version | if $icon == "" then . else .icon = $icon end
            else error("not a card/1 object") end' card.json > build/card.json; then
            echo "card.json must hold one JSON object whose \"veduta\" is \"card/1\"" >&2
            exit 1
          fi
          # linux/arm64 is the console (Raspberry Pi Zero 2 W and Pi 5); linux/amd64 runs on
          # any other Linux machine with a framebuffer. Each archive unpacks to a folder that
          # is a game card as it is: copy it onto the console's card.
          for target in linux/arm64 linux/amd64; do
            os="${target%/*}"
            arch="${target#*/}"
            stage="build/${os}_${arch}/${name}"
            mkdir -p "$stage"
            GOOS="$os" GOARCH="$arch" go build -trimpath -ldflags "-s -w" -o "$stage/$name" ./cmd/game
            cp veduta.json README.md build/card.json "$stage/"
            if [ -n "$icon" ]; then cp "$icon" "$stage/icon.png"; fi
            cp -r assets "$stage/assets"
            rm -rf "$stage/assets/.cooked"
            tar -C "build/${os}_${arch}" -czf "dist/${name}_${tag}_${os}_${arch}.tar.gz" "$name"
          done
          (cd dist && sha256sum * > checksums.txt)
          cat dist/checksums.txt

      - name: publish
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          # A tag with a pre-release suffix (v0.2.0-rc.1) is published as a pre-release.
          pre=""
          case "${GITHUB_REF_NAME}" in *-*) pre="--prerelease" ;; esac
          gh release create "${GITHUB_REF_NAME}" $pre --generate-notes dist/*
