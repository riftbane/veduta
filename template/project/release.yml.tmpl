name: release

on:
  push:
    tags: ["v*"]

permissions:
  contents: write

env:
  CGO_ENABLED: "0"
  GOAMD64: v1

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - uses: actions/setup-go@v6
        with:
          go-version-file: go.mod

      - name: build archives
        run: |
          set -eu
          tag="${GITHUB_REF_NAME}"
          name="[[.Name]]"
          mkdir -p dist
          # linux/arm64 is the console (Raspberry Pi Zero 2 W and Pi 5); linux/amd64 runs on
          # any other Linux machine with a framebuffer. Each archive unpacks to a folder that
          # is a game card as it is: copy it onto the console's card.
          for target in linux/arm64 linux/amd64; do
            os="${target%/*}"
            arch="${target#*/}"
            stage="build/${os}_${arch}/${name}"
            mkdir -p "$stage"
            GOOS="$os" GOARCH="$arch" go build -trimpath -ldflags "-s -w" -o "$stage/$name" ./cmd/game
            cp veduta.json README.md "$stage/"
            # card.json is what the console lists; the release stamps its version.
            awk -v tag="$tag" '{ print } /"veduta": *"card\/1",/ { print "  \"version\": \"" tag "\"," }' card.json > "$stage/card.json"
            cp -r assets "$stage/assets"
            rm -rf "$stage/assets/.cooked"
            tar -C "build/${os}_${arch}" -czf "dist/${name}_${tag}_${os}_${arch}.tar.gz" "$name"
          done
          (cd dist && sha256sum * > checksums.txt)
          cat dist/checksums.txt

      - name: publish
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          # A tag with a pre-release suffix (v0.2.0-rc.1) is published as a pre-release.
          pre=""
          case "${GITHUB_REF_NAME}" in *-*) pre="--prerelease" ;; esac
          gh release create "${GITHUB_REF_NAME}" $pre --generate-notes dist/*
